---
// An app screenshot inside a drawn iPhone. The captures in src/assets/screens are plain
// simulator screenshots (1320 × 2868), so the frame, Dynamic Island and buttons are CSS.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** How wide the phone is drawn, for the browser's choice of image. */
  sizes?: string;
  /** Load straight away rather than lazily; for a phone visible on arrival. */
  eager?: boolean;
  class?: string;
}

const { src, alt, sizes = "280px", eager = false, class: className } = Astro.props;
---

<div class:list={["phone", className]}>
  <div class="phone-body">
    <div class="phone-screen">
      <Image
        src={src}
        alt={alt}
        widths={[280, 420, 560, 840]}
        sizes={sizes}
        quality={82}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
      />
    </div>
  </div>
</div>
