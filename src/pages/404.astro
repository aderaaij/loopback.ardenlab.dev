---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found – Loopback" footer={false}>
  <main class="wrap doc" data-enter>
    <p class="label">404</p>
    <h1>That page isn't here.</h1>
    <p class="meta">
      Try the <a href="/">home page</a>, <a href="/support/">support</a> or the <a href="/privacy/">privacy policy</a>.
    </p>
  </main>
</Base>
