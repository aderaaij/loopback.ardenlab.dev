---
import { getImage } from "astro:assets";
import Phone from "../components/Phone.astro";
import Base from "../layouts/Base.astro";
import duskPoster from "../assets/posters/dusk.jpg";
import trackPoster from "../assets/posters/track.jpg";
import plannedWorkout from "../assets/screens/planned-workout.png";
import run from "../assets/screens/run.png";
import sharing from "../assets/screens/sharing.png";
import training from "../assets/screens/training.png";
import trendsFuel from "../assets/screens/trends-fuel.png";

// The clips in public/video sit behind a dark scrim, so their still frames can be small.
const poster = async (src: ImageMetadata) => (await getImage({ src, width: 1280, format: "webp", quality: 60 })).src;
const posters = { dusk: await poster(duskPoster), track: await poster(trackPoster) };

const screens = [
  {
    src: plannedWorkout,
    alt: "A planned tempo run in Loopback: a 15 minute warm-up, a 5,900 metre work block and a 10 minute cooldown, with an option to move or skip the run.",
    title: "Planned workouts",
    text: "Each planned workout lists its warm-up, work blocks and cooldown, as your watch will run them. You can move or skip it from the same screen.",
  },
  {
    src: run,
    alt: "A finished run in Loopback: distance, duration, average pace and heart rate, the route on a map and a heart-rate chart coloured by zone.",
    title: "Completed runs",
    text: "Each run shows distance, pace, heart rate by zone, the route and a split for every kilometre.",
  },
  {
    src: trendsFuel,
    alt: "The Trends tab in Loopback showing seven-day nutrition averages, macros per day and a bar chart of daily energy.",
    title: "Trends",
    text: "Charts of your mileage and missed sessions over time, plus nutrition if you share it.",
  },
];

// Six stops spaced evenly along the track's length, clockwise from the top left.
// The track is a 820-long straight, a half circle of radius 60, and the same again back.
const stops = [
  { x: 70, y: 10 },
  { x: 406, y: 10 },
  { x: 742, y: 10 },
  { x: 890, y: 130 },
  { x: 554, y: 130 },
  { x: 218, y: 130 },
].map((stop, i) => ({ ...stop, label: String(i + 1).padStart(2, "0") }));
---

<Base
  title="Loopback – Running Coach for your own server"
  description="Loopback is an open-source iOS running coach that syncs Apple Health to a training server you host yourself. Plans go to your Apple Watch; your data stays with you."
  path="/"
>
  <Fragment slot="head">
    <meta property="og:title" content="Loopback – Running Coach" />
    <meta
      property="og:description"
      content="An open-source iOS running coach that syncs Apple Health to a training server you host yourself."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://loopback.ardenlab.dev/" />
  </Fragment>

  <main>
    <section class="hero">
      <div class="backdrop" aria-hidden="true">
        <video class="clip" muted loop playsinline preload="none" poster={posters.dusk} tabindex="-1">
          <source src="/video/dusk.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="wrap hero-grid">
        <div class="hero-copy" data-enter>
          <p class="label">Running coach for iPhone · open source</p>
          <h1>Your training data, on <em>your own server.</em></h1>
          <p class="lede">Loopback reads your runs, sleep and recovery data from Apple Health and sends them to a training server you host yourself. An AI assistant you connect to that server writes your training plan, and the app puts each workout on your Apple Watch.</p>

          <div class="notice">
            <p><strong>You need to run your own server.</strong> The app only works with the open-source Loopback Server, and there is no hosted version to sign in to.</p>
          </div>

          <div class="actions">
            <a class="button primary" href="https://github.com/aderaaij/loopback-training-server#quick-start">Set up the server</a>
            <a class="button" href="https://testflight.apple.com/join/fV73tucs">Get the beta on TestFlight</a>
          </div>
        </div>
        <div class="hero-device" data-enter>
          <Phone
            src={training}
            alt="The Training tab in Loopback: a 10K plan in week 5 of 8 with 13 of 18 workouts done, this week's calendar and today's completed run."
            sizes="(min-width: 860px) 300px, min(68vw, 280px)"
            eager
          />
        </div>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="loop-title">
      <p class="label" data-reveal>How it works</p>
      <h2 data-reveal id="loop-title">From the coach to your watch and back again.</h2>
      <svg class="track" viewBox="0 0 960 140" aria-hidden="true" data-reveal>
        <path class="track-base" d="M70 10 H890 A60 60 0 0 1 890 130 H70 A60 60 0 0 1 70 10 Z"></path>
        <path class="track-progress" pathLength="1" d="M70 10 H890 A60 60 0 0 1 890 130 H70 A60 60 0 0 1 70 10 Z"></path>
        {
          stops.map((stop) => (
            <g class="track-stop">
              <circle cx={stop.x} cy={stop.y} r="4" />
              <text x={stop.x} y={stop.y === 10 ? 40 : 108} text-anchor="middle">{stop.label}</text>
            </g>
          ))
        }
        <circle class="track-dot" cx="70" cy="10" r="7"></circle>
      </svg>
      <ol class="loop" data-reveal="children">
        <li>
          <h3>The coach writes a plan</h3>
          <p>An AI assistant connected to your server builds a training plan and queues workouts, using your history as context.</p>
        </li>
        <li>
          <h3>The app sends it to your watch</h3>
          <p>Structured workouts with warm-up, intervals, cooldown and pace or heart-rate alerts are scheduled on Apple Watch.</p>
        </li>
        <li>
          <h3>You run</h3>
          <p>Apple Watch records the workout as usual. There is nothing extra to carry and nothing to start in Loopback.</p>
        </li>
        <li>
          <h3>The run uploads to your server</h3>
          <p>Route, splits, heart rate and running dynamics are sent in the background and matched to the planned workout.</p>
        </li>
        <li>
          <h3>Recovery data syncs daily</h3>
          <p>Sleep, resting heart rate, HRV and anything else you chose to share sync once a day, so the coach can take them into account.</p>
        </li>
        <li>
          <h3>The plan changes when you miss a session</h3>
          <p>If you miss a session you can say why, then move or skip it. The coach adjusts the workouts that follow.</p>
        </li>
      </ol>
      <p class="loop-return" data-reveal><span>↺</span> and back to 01.</p>
    </section>

    <section class="interlude" aria-label="On the run">
      <div class="backdrop" aria-hidden="true">
        <video class="clip" muted loop playsinline preload="none" poster={posters.track} tabindex="-1">
          <source src="/video/track.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="wrap">
        <p class="label" data-reveal>On the run</p>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="app-title">
      <p class="label" data-reveal>In the app</p>
      <h2 data-reveal id="app-title">What you see in the app.</h2>
      <ul class="screens" data-reveal="children">
        {
          screens.map((screen) => (
            <li>
              <Phone src={screen.src} alt={screen.alt} sizes="(min-width: 720px) 260px, min(64vw, 260px)" />
              <h3>{screen.title}</h3>
              <p>{screen.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap section" aria-labelledby="data-title">
      <p class="label" data-reveal>What you share</p>
      <h2 data-reveal id="data-title">You choose what the coach can see.</h2>
      <p class="intro" data-reveal>Loopback asks which of these five kinds of data to read from Apple Health when you set it up, and you can change that later in Settings. Only Training is required. What you share is sent to your server and nowhere else. The <a href="/privacy/">privacy policy</a> has the full list.</p>
      <div class="sharing">
          <dl class="domains" data-reveal="children">
            <div>
              <dt>Training <small>Required</small></dt>
              <dd>Runs and other workouts, routes, heart rate and effort.</dd>
            </div>
            <div>
              <dt>Recovery <small>Optional</small></dt>
              <dd>Sleep, resting heart rate, HRV, breathing and blood oxygen.</dd>
            </div>
            <div>
              <dt>Body <small>Optional</small></dt>
              <dd>Weight, body composition and VO₂ max.</dd>
            </div>
            <div>
              <dt>Daily activity <small>Optional</small></dt>
              <dd>Steps and energy burned across the day.</dd>
            </div>
            <div>
              <dt>Nutrition <small>Optional</small></dt>
              <dd>Food and drink you log in other apps.</dd>
            </div>
          </dl>
        <div data-reveal>
          <Phone
            src={sharing}
            alt="Sync settings in Loopback: Training is always shared, with switches for Recovery, Body, Daily activity and Nutrition."
            sizes="(min-width: 820px) 260px, min(64vw, 260px)"
          />
        </div>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="get-title">
      <p class="label" data-reveal>Get started</p>
      <h2 data-reveal id="get-title">Install the server, then the app.</h2>
      <div class="columns" data-reveal="children">
        <div>
          <h3>Loopback Server</h3>
          <p>A FastAPI and PostgreSQL service that runs in Docker on a home server, NAS or VPS. It stores your training, serves a web dashboard and exposes an MCP endpoint for your AI assistant.</p>
          <p><a href="https://github.com/aderaaij/loopback-training-server">loopback-training-server on GitHub</a></p>
        </div>
        <div>
          <h3>Loopback for iPhone</h3>
          <p>Requires iOS 26. The public beta installs through TestFlight, or you can build it from source with Xcode 26. An Apple Watch is needed for scheduled workouts.</p>
          <p><a href="https://testflight.apple.com/join/fV73tucs">Join the beta on TestFlight</a> · <a href="https://github.com/aderaaij/loopback-training-app">loopback-training-app on GitHub</a></p>
        </div>
      </div>
    </section>
  </main>
</Base>
