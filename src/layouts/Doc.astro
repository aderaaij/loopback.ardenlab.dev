---
import Base from "./Base.astro";

// Layout for the Markdown pages (privacy, support, connect). Fields come from the page's frontmatter.
// `noindex` is for a page people only reach through a link someone made for them.
const { title, description, path, label, heading, effective, noindex } = Astro.props.frontmatter;
---

<Base title={title} description={description} path={path}>
  {noindex && <meta name="robots" content="noindex" slot="head" />}
  <main class="wrap doc" data-enter>
    <p class="label">{label}</p>
    <h1>{heading}</h1>
    {effective && <p class="meta">Effective {effective}</p>}
    <div><slot /></div>
  </main>
</Base>
