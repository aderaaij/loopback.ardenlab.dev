{
  // Static site for loopback.ardenlab.dev, built by Astro into ./dist. No Worker code, assets only.
  "name": "loopback-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "loopback.ardenlab.dev", "custom_domain": true }
  ]
}
